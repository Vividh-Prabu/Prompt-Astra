# ---------------------------------------------------------------------------
# PromptAstra Frontend — environment configuration
# Copy this file to `.env` and fill in your values. `.env` is git-ignored.
# Every value here is OPTIONAL: with none set, the UI runs on local demo data.
# ---------------------------------------------------------------------------

# --- Supabase (to show LIVE security_events instead of demo JSON) -----------
# Your project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=
# A Supabase API key. For a server-side app like this Flask backend, the
# service-role key is simplest (it bypasses Row Level Security). If you prefer
# the anon key, add RLS policies that allow select/insert on security_events.
SUPABASE_KEY=
# Optional: set this to explicitly use the service-role key (takes priority).
SUPABASE_SERVICE_KEY=

# Set to 0 if you point the frontend at the FastAPI backend (which already
# logs to Supabase) so events aren't written twice. Default: 1 (frontend logs).
FRONTEND_WRITES_SUPABASE=1

# --- Optional: use a live ML backend instead of the built-in demo engine ----
# If set, prompts are sent to <PROMPTGUARD_API_URL>/analyze; otherwise the
# deterministic local heuristic engine is used (Demo Mode).
PROMPTGUARD_API_URL=
PROMPTGUARD_API_KEY=
PROMPTGUARD_TIMEOUT=5.0

# --- Flask ------------------------------------------------------------------
FLASK_SECRET_KEY=promptastra-dev-secret-key-2026
PORT=5000
