{
  "manifest_version": 3,
  "name": "PromptAstra - AI Security Gateway",
  "version": "1.0.0",
  "description": "Real-time AI prompt injection and jailbreak threat inspector.",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PromptAstra Security Scanner",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ]
}